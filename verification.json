{
  "scope": "AI Kit runner, verification pipeline and documentation checks.",
  "required_categories": [
    "structure",
    "unit",
    "e2e",
    "negative"
  ],
  "requirements": [
    {
      "id": "kit-structure",
      "checks": [
        "kit-structure"
      ]
    },
    {
      "id": "kit-unit",
      "checks": [
        "kit-unit"
      ]
    },
    {
      "id": "kit-smoke",
      "checks": [
        "kit-smoke"
      ]
    },
    {
      "id": "kit-negative",
      "checks": [
        "kit-negative"
      ]
    },
    {
      "id": "kit-docs",
      "checks": [
        "kit-docs"
      ]
    }
  ],
  "checks": [
    {
      "id": "kit-structure",
      "name": "Required kit files",
      "category": "structure",
      "oracle": "Required files and directories match the kit layout.",
      "paths": [
        {
          "path": "README.md",
          "kind": "file"
        },
        {
          "path": "AGENTS.md",
          "kind": "file"
        },
        {
          "path": ".agents/skills/solve/SKILL.md",
          "kind": "file"
        },
        {
          "path": "scripts/run_experiment.py",
          "kind": "file"
        },
        {
          "path": "scripts/verify_pipeline.py",
          "kind": "file"
        },
        {
          "path": "scripts/check_docs.py",
          "kind": "file"
        },
        {
          "path": "templates/PLAN.md",
          "kind": "file"
        },
        {
          "path": "templates/BLOCK.md",
          "kind": "file"
        },
        {
          "path": "templates/SUB_BLOCK.md",
          "kind": "file"
        },
        {
          "path": "templates/verification.json",
          "kind": "file"
        },
        {
          "path": "tests",
          "kind": "directory"
        }
      ]
    },
    {
      "id": "kit-unit",
      "name": "Runner and verification regression tests",
      "category": "unit",
      "oracle": "Independent assertions validate success, failure, timeouts and reporting.",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "timeout": 60
    },
    {
      "id": "kit-smoke",
      "name": "Example command execution",
      "category": "e2e",
      "oracle": "Example command exits successfully; regression tests inspect log content.",
      "command": [
        "{python}",
        "examples/demo.py",
        "--mode",
        "success"
      ],
      "timeout": 10
    },
    {
      "id": "kit-negative",
      "name": "Expected error exit code",
      "category": "negative",
      "oracle": "Failure example returns exit code 7.",
      "command": [
        "{python}",
        "examples/demo.py",
        "--mode",
        "fail"
      ],
      "expected_exit": 7,
      "timeout": 10
    },
    {
      "id": "kit-docs",
      "name": "English documents and function docstrings",
      "category": "other",
      "oracle": "Tracked text is English; every function has a leading triple-single-quoted purpose/Args/Returns docstring.",
      "command": [
        "{python}",
        "scripts/check_docs.py"
      ],
      "timeout": 10
    }
  ]
}
